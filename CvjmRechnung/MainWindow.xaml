<Window x:Class="CvjmRechnung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CvjmRechnung"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel>
                <Label Content="Vor- und Nachname" />
                <TextBox />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <Label Content="Straße und Hausnummer" />
                <TextBox />
            </StackPanel>
            <StackPanel Grid.Row="2">
                <Label Content="PLZ und Ort" />
                <TextBox />
            </StackPanel>
            <DataGrid Grid.Row="3">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#">
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Anzahl"/>
                    <DataGridTextColumn Header="Position" Width="*">
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Einselpreis"></DataGridTextColumn>
                    <DataGridTextColumn Header="Gesamtpreis"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
