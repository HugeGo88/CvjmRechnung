<Window
    x:Class="CvjmRechnung.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:CvjmRechnung"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CvjmRechnung.ViewModel"
    xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="CVJM Rechnung"
    d:Height="600"
    d:Width="800"
    Icon="/Resources/logo.png"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <Button Command="{Binding AddNewInvoiceCommand}" Content="Neue Rechnung" />
                </StackPanel>
                <ListView
                    Grid.Row="1"
                    Grid.Column="0"
                    ItemsSource="{Binding Invoices}"
                    SelectedItem="{Binding SelectedItem}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="SAVED">
                                    <Setter Property="Background" Value="LightBlue" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="PDF_CREATED">
                                    <Setter Property="Background" Value="LightYellow" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="EMAIL_SEND">
                                    <Setter Property="Background" Value="LightCoral" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="INVOICE_PAID">
                                    <Setter Property="Background" Value="LightGreen" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="KeyUp">
                            <i:InvokeCommandAction Command="{Binding DeleteSelectedInvoiceCommand}" PassEventArgsToCommand="True" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Datum: " />
                                    <TextBlock FontWeight="Bold" Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" />
                                    <TextBlock Text=" Rechnung: " />
                                    <TextBlock FontWeight="Bold" Text="{Binding OrderNumber}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="Name: " />
                                    <TextBlock FontWeight="Bold" Text="{Binding FirstAndLastName}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="Status: " />
                                    <TextBlock FontWeight="Bold" Text="{Binding State}" />
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="5">
                    <Label Content="Reservierungs- oder Rechnungsnummer" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SelectedItem.OrderNumber}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding ReadCalendarCommand}"
                            Content="Suchen" />
                    </Grid>
                    <Label Content="Firmenname" />
                    <TextBox Text="{Binding SelectedItem.CompanyName}" />
                    <Label Content="Vor- und Nachname" />
                    <TextBox Text="{Binding SelectedItem.FirstAndLastName}" />
                    <Label Content="Straße und Hausnummer" />
                    <TextBox Text="{Binding SelectedItem.StreetAndNumber}" />
                    <Label Content="PLZ und Ort" />
                    <TextBox Text="{Binding SelectedItem.PostalCodeAndCity}" />
                    <Label Content="Email" />
                    <TextBox Text="{Binding SelectedItem.EmailAddress}" />
                    <Label Content="Rechnungsdatum" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <DatePicker FirstDayOfWeek="Monday" SelectedDate="{Binding SelectedItem.Date}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SetCurrentDateCommand}"
                            Content="Heute" />
                    </Grid>
                    <Button
                        Grid.Row="4"
                        Margin="0,10"
                        HorizontalAlignment="Right"
                        Command="{Binding AddRowCommand}"
                        Content="Zeile hinzufügen" />
                </StackPanel>
                <DataGrid
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding SelectedItem.InvoiceRows}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="CellEditEnding">
                            <i:InvokeCommandAction Command="{Binding CalculatePriceCommand}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding CalculatePriceCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Path=Position}"
                            Header="#"
                            IsReadOnly="True" />
                        <DataGridTextColumn Binding="{Binding Path=Quantity}" Header="Anzahl" />
                        <DataGridTextColumn Binding="{Binding Path=Unit, UpdateSourceTrigger=PropertyChanged}" Header="Einheit" />
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <ComboBoxItem Content="Vereinsheim" />
                                        <ComboBoxItem Content="Gelände" />
                                        <ComboBoxItem Content="Vereinsheim und Gelände" />
                                        <ComboBoxItem Content="Endreinigung" />
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding Path=UnitPrice, UpdateSourceTrigger=PropertyChanged}" Header="Einzelpreis" />
                        <DataGridTextColumn
                            Binding="{Binding Path=TotalPrice}"
                            Header="Gesamtpreis"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="Gesamtbetrag" FontStyle="Oblique" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Label Content="{Binding TotalAmount}" FontWeight="Bold" />
                        <Label Content="€" FontStyle="Oblique" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                        <Button Command="{Binding SaveFileCommand}" Content="Speichern" />
                        <Button Command="{Binding GeneratePdfCommand}" Content="PDF erzeugen" />
                        <Button Command="{Binding SendMailCommand}" Content="Rechnung via Email senden" />
                        <Button Command="{Binding InvoicePaidCommand}" Content="Rechnung als bezahlt markieren" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            ShowsPreview="False" />
        <wpf:WebView2 Grid.Column="2" Source="{Binding PdfPath}" />
    </Grid>
</Window>
