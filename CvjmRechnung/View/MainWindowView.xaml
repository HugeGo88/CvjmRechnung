<Window
    x:Class="CvjmRechnung.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CvjmRechnung"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CvjmRechnung.ViewModel"
    Title="CVJM Rechnung"
    Width="1200"
    Height="800"
    mc:Ignorable="d">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="5">
                <Label Content="Reservierungs- oder Rechnungsnummer" />
                <TextBox Text="{Binding OrderNumber}" />
                <Label Content="Vor- und Nachname" />
                <TextBox Text="{Binding FirstAndLastName}" />
                <Label Content="Straße und Hausnummer" />
                <TextBox Text="{Binding StreetAndNumber}" />
                <Label Content="PLZ und Ort" />
                <TextBox Text="{Binding PostalCodeAndCity}" />
                <Label Content="Email" />
                <TextBox Text="{Binding EmailAddress}" />
                <Label Content="Rechnungsdatum" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <DatePicker FirstDayOfWeek="Monday" SelectedDate="{Binding Date}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding SetCurrentDateCommand}"
                        Content="Heute" />
                </Grid>
                <Label Content="Mietgegenstände" />
                <ComboBox ItemsSource="{Binding Rents}" SelectedItem="{Binding Rent}" />
                <CheckBox Margin="0,7,0,0" IsChecked="{Binding IsMember}">
                    <TextBlock Text="Ist Mitglied" />
                </CheckBox>
                <Button
                    Grid.Row="4"
                    Margin="0,10"
                    HorizontalAlignment="Right"
                    Command="{Binding AddRowCommand}"
                    Content="Zeile hinzufügen" />
            </StackPanel>
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ItemsSource="{Binding InvoiceRows, UpdateSourceTrigger=PropertyChanged}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding Path=Position}"
                        Header="#"
                        IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Path=Quantity}" Header="Anzahl" />
                    <DataGridTextColumn Binding="{Binding Path=UnitPrice}" Header="Einheit" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Path=Description}"
                        Header="Beschreibung" />
                    <DataGridTextColumn Binding="{Binding Path=UnitPrice}" Header="Einselpreis" />
                    <DataGridTextColumn
                        Binding="{Binding Path=TotalPrice}"
                        Header="Gesamtpreis"
                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="Summe" FontStyle="Oblique" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Label Content="{Binding TotalAmount}" FontWeight="Bold" />
                    <Label Content="€" FontStyle="Oblique" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Command="{Binding SaveFileCommand}"
                    Content="Speichern" />
            </Grid>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Command="{Binding GeneratePdfCommand}" Content="PDF erzeugen" />
            <Button Grid.Row="2" Content="Rechnung via Email senden" />
        </Grid>
    </Grid>
</Window>
