<Window
    x:Class="CvjmRechnung.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:CvjmRechnung"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CvjmRechnung.ViewModel"
    xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="CVJM Rechnung"
    d:Height="600"
    d:Width="800"
    Icon="/Resources/logo.png"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="1">
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding OpenSettingsCommand}"
                        Content="Einstellungen" />
                    <ListView
                        Grid.Row="1"
                        Grid.Column="0"
                        ItemsSource="{Binding Invoices}"
                        SelectedItem="{Binding SelectedItem}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="SAVED">
                                        <Setter Property="Background" Value="LightBlue" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="PDF_CREATED">
                                        <Setter Property="Background" Value="LightYellow" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="EMAIL_SEND">
                                        <Setter Property="Background" Value="LightCoral" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="INVOICE_PAID">
                                        <Setter Property="Background" Value="LightGreen" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="KeyUp">
                                <i:InvokeCommandAction Command="{Binding DeleteSelectedInvoiceCommand}" PassEventArgsToCommand="True" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <WrapPanel>
                                            <TextBlock Text="Datum: " />
                                            <TextBlock FontWeight="Bold" Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" />
                                            <TextBlock Text=" Rechnung: " />
                                            <TextBlock FontWeight="Bold" Text="{Binding OrderNumber}" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Name: " />
                                            <TextBlock FontWeight="Bold" Text="{Binding FirstAndLastName}" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Status: " />
                                            <TextBlock FontWeight="Bold" Text="{Binding State}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        FontWeight="Bold"
                                        Text="{Binding TotalAmount, StringFormat={}{0:N2} €}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Margin="8,8,0,0" Orientation="Horizontal">
                        <Label Content="Summe aktuelles Jahr:" FontWeight="Bold" />
                        <Label Content="{Binding CurrentYearTotalAmount}" FontWeight="Bold" />
                        <Label Content="€" FontStyle="Oblique" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="5">
                        <Button Command="{Binding AddNewInvoiceCommand}" Content="Neue Rechnung" />
                        <Label Content="Reservierungs- oder Rechnungsnummer" FontWeight="Bold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                FontWeight="Bold"
                                Text="{Binding SelectedItem.OrderNumber}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding SearchEventCommand}"
                                Content="Suchen" />
                        </Grid>
                        <Label Content="Firmenname" FontWeight="Bold" />
                        <TextBox Text="{Binding SelectedItem.CompanyName}" />
                        <Label Content="Vor- und Nachname" FontWeight="Bold" />
                        <TextBox Text="{Binding SelectedItem.FirstAndLastName}" />
                        <Label Content="Straße und Hausnummer" FontWeight="Bold" />
                        <TextBox Text="{Binding SelectedItem.StreetAndNumber}" />
                        <Label Content="PLZ und Ort" FontWeight="Bold" />
                        <TextBox Text="{Binding SelectedItem.PostalCodeAndCity}" />
                        <Label Content="Email" FontWeight="Bold" />
                        <TextBox Text="{Binding SelectedItem.EmailAddress}" />
                        <Label Content="Beschreibung" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedItem.Description}" TextWrapping="Wrap" />
                        <Label Content="Rechnungsdatum" FontWeight="Bold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <DatePicker FirstDayOfWeek="Monday" SelectedDate="{Binding SelectedItem.Date}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding SetCurrentDateCommand}"
                                Content="Heute" />
                        </Grid>
                        <Button
                            Grid.Row="4"
                            Margin="0,10"
                            HorizontalAlignment="Right"
                            Command="{Binding AddRowCommand}"
                            Content="Zeile hinzufügen" />
                    </StackPanel>
                    <DataGrid
                        Grid.Row="1"
                        MinHeight="200"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding SelectedItem.InvoiceRows}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="CellEditEnding">
                                <i:InvokeCommandAction Command="{Binding CalculatePriceCommand}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding CalculatePriceCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Binding="{Binding Path=Position}"
                                Header="#"
                                IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Path=Quantity}" Header="Anzahl" />
                            <DataGridTextColumn Binding="{Binding Path=Unit, UpdateSourceTrigger=PropertyChanged}" Header="Einheit" />
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                            <ComboBoxItem Content="Vereinsheim" />
                                            <ComboBoxItem Content="Gelände" />
                                            <ComboBoxItem Content="Vereinsheim und Gelände" />
                                            <ComboBoxItem Content="Endreinigung" />
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Path=UnitPrice, UpdateSourceTrigger=PropertyChanged}" Header="Einzelpreis" />
                            <DataGridTextColumn
                                Binding="{Binding Path=TotalPrice}"
                                Header="Gesamtpreis"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Label Content="Gesamtbetrag" FontStyle="Oblique" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Label Content="{Binding TotalAmount}" FontWeight="Bold" />
                            <Label Content="€" FontStyle="Oblique" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <Button Command="{Binding SaveFileCommand}" Content="Speichern" />
                            <Label Content="CSS-Stil für PDF" FontWeight="Bold" />
                            <ComboBox
                                ItemsSource="{Binding AvailableCssFiles}"
                                SelectedItem="{Binding SelectedCssFile}"
                                ToolTip="CSS-Datei aus %appdata%\CvjmRechnung\css auswählen" />
                            <Button Command="{Binding GeneratePdfCommand}" Content="PDF erzeugen" />
                            <Button
                                Command="{Binding SendMailCommand}"
                                Content="Rechnung via Email senden"
                                ToolTip="Senden ist erst nach PDF-Erstellung und Eingabe der Email möglich."
                                ToolTipService.ShowOnDisabled="True" />
                            <Button
                                Command="{Binding InvoicePaidCommand}"
                                Content="Rechnung als bezahlt markieren"
                                ToolTip="Markieren ist erst nach Versand der Email möglich."
                                ToolTipService.ShowOnDisabled="True" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            ShowsPreview="False" />
        <wpf:WebView2 Grid.Column="2" Source="{Binding SelectedItem.PdfPath}" />
    </Grid>
</Window>
