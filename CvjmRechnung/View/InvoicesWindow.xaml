<Window
    x:Class="CvjmRechnung.View.InvoicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CvjmRechnung.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="InvoicesView"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <ListView
            x:Name="ListViewItems"
            Grid.Row="1"
            Grid.Column="1"
            MouseDoubleClick="ListViewItems_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Beginn: " />
                            <TextBlock FontWeight="Bold" Text="{Binding StartDateString}" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Reservierungsnummer: " />
                            <TextBlock FontWeight="Bold" Text="{Binding EventId}" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Veranstaltungsname: " />
                            <TextBlock FontWeight="Bold" Text="{Binding EventName}" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Name: " />
                            <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                        </WrapPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
