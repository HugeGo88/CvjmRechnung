<Window x:Class="CvjmRechnung.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Height="420"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="E-Mail Passwort" Margin="0,0,0,6" />
        <PasswordBox Grid.Row="1" x:Name="PasswordBox" />

        <TextBlock Grid.Row="2" Text="Rechnungsordner" Margin="0,12,0,6" />
        <TextBox Grid.Row="3" x:Name="InvoicePathTextBox" />

        <TextBlock Grid.Row="4" Text="Einstellungen- und Template-Ordner" Margin="0,12,0,6" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SettingsPathTextBox" />
            <Button Grid.Column="1"
                    Content="..."
                    Width="36"
                    Margin="8,0,0,0"
                    Click="BrowseSettingsPath_Click" />
        </Grid>

        <TextBlock Grid.Row="6" Text="CSS-Stil fuer PDF" Margin="0,12,0,6" />
        <ComboBox Grid.Row="7"
                  x:Name="CssFileComboBox" />

        <TextBlock Grid.Row="8" Text="HTML-Template fuer PDF" Margin="0,12,0,6" />
        <ComboBox Grid.Row="9"
                  x:Name="TemplateFileComboBox" />

        <StackPanel Grid.Row="11"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Speichern"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="Save_Click" />
            <Button Content="Abbrechen"
                    Width="100"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>